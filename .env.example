# Copy to .env and fill in. Only FRUNK_OWNER_EMAIL is required.

# Public address, used in invite and pairing links (no trailing slash)
FRUNK_PUBLIC_URL=http://localhost:3000
# This email becomes the admin. On first start the log prints a link to set its password.
FRUNK_OWNER_EMAIL=you@example.com

# Reverse proxies whose X-Forwarded-For / X-Real-IP headers are trusted
# (IPs or CIDRs, comma-separated). Default: 127.0.0.1,::1
# TRUSTED_PROXIES=192.168.1.10

# Google sign-in (optional). See README for the Google Cloud setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invite emails (optional). Without these, invite links are copied for you to send.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Frunk <frunk@example.com>
